generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. SHOPIFY DATA LAYER
// -------------------------------------------------------------

model ShopifyStore {
  id                String    @id @default(cuid())
  shopDomain        String    @unique
  accessToken       String
  apiKey            String?
  apiSecret         String?
  webhookSecret     String?
  storeName         String?
  email             String?
  currency          String?   @default("INR")
  isConnected       Boolean   @default(true)
  lastProductSyncAt DateTime?
  lastOrderSyncAt   DateTime?
  lastFullSyncAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products      ShopifyProduct[]
  variants      ShopifyVariant[]
  orders        ShopifyOrder[]
  orderItems    ShopifyOrderItem[]
  fulfillments  ShopifyFulfillment[]
  syncLogs      SyncLog[]
  webhookEvents ShopifyWebhookEvent[]

  @@map("shopify_stores")
}

model ShopifyProduct {
  id               String   @id @default(cuid())
  storeId          String
  shopifyProductId String
  title            String
  handle           String?
  productType      String?
  vendor           String?
  status           String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  tags             String?
  imageUrl         String?
  rawPayload       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  syncedAt         DateTime @default(now())

  store    ShopifyStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants ShopifyVariant[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId, status])
  @@map("shopify_products")
}

model ShopifyVariant {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  shopifyProductId  String
  shopifyVariantId  String   @unique // CRITICAL: Shopify Variant ID for VOOP BOM Mapping
  title             String
  sku               String?  @default("")
  barcode           String?
  price             Float    @default(0.0)
  compareAtPrice    Float?
  inventoryItemId   String?
  inventoryQuantity Int?     @default(0)
  imageUrl          String?
  rawPayload        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  syncedAt          DateTime @default(now())

  store   ShopifyStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  bom     Bom?

  @@unique([storeId, shopifyVariantId])
  @@index([storeId, sku])
  @@index([shopifyVariantId])
  @@map("shopify_variants")
}

model ShopifyOrder {
  id                String    @id @default(cuid())
  storeId           String
  shopifyOrderId    String
  orderNumber       String // e.g. "10542"
  name              String // e.g. "#10542"
  email             String?
  phone             String?
  currency          String    @default("INR")
  totalPrice        Float     @default(0.0)
  subtotalPrice     Float     @default(0.0)
  totalDiscounts    Float     @default(0.0)
  totalTax          Float     @default(0.0)
  financialStatus   String    @default("PAID") // PAID, PENDING, REFUNDED, PARTIALLY_PAID, VOIDED
  fulfillmentStatus String    @default("UNFULFILLED") // FULFILLED, UNFULFILLED, PARTIAL, RESTOCKED
  processedAt       DateTime?
  cancelledAt       DateTime?
  tags              String?
  note              String?
  shippingAddress   String? // JSON string of shipping address
  rawPayload        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  syncedAt          DateTime  @default(now())

  store        ShopifyStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items        ShopifyOrderItem[]
  fulfillments ShopifyFulfillment[]

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, orderNumber])
  @@index([storeId, financialStatus])
  @@index([storeId, fulfillmentStatus])
  @@index([createdAt])
  @@map("shopify_orders")
}

model ShopifyOrderItem {
  id                String   @id @default(cuid())
  storeId           String
  orderId           String
  shopifyOrderId    String
  shopifyLineItemId String
  shopifyProductId  String?
  shopifyVariantId  String? // CRITICAL: Preserves exact Shopify Variant ID for VOOP
  productTitle      String
  variantTitle      String?
  sku               String?  @default("")
  quantity          Int      @default(1)
  unitPrice         Float    @default(0.0)
  discountTotal     Float    @default(0.0)
  totalPrice        Float    @default(0.0)
  rawPayload        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyLineItemId])
  @@index([storeId, shopifyVariantId])
  @@index([sku])
  @@map("shopify_order_items")
}

model ShopifyFulfillment {
  id                   String   @id @default(cuid())
  storeId              String
  orderId              String
  shopifyOrderId       String
  shopifyFulfillmentId String
  status               String   @default("SUCCESS")
  trackingCompany      String?
  trackingNumber       String?
  trackingUrl          String?
  lineItemIds          String? // Comma-separated or JSON of fulfilled line item IDs
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyFulfillmentId])
  @@index([trackingNumber])
  @@map("shopify_fulfillments")
}

// -------------------------------------------------------------
// 2. VOOP OPERATIONAL LAYER (BOM & INVENTORY)
// -------------------------------------------------------------

model Bom {
  id               String   @id @default(cuid())
  shopifyVariantId String   @unique
  variantSku       String?
  productTitle     String
  variantTitle     String?
  totalCost        Float    @default(0.0) // Sum of all component costs
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant ShopifyVariant @relation(fields: [shopifyVariantId], references: [shopifyVariantId], onDelete: Cascade)
  items   BomItem[]

  @@map("voop_boms")
}

model BomItem {
  id               String   @id @default(cuid())
  bomId            String
  componentId      String? // Link to ComponentInventory
  componentSku     String
  componentName    String
  quantityRequired Float    @default(1.0)
  unit             String   @default("pcs") // pcs, ml, g, meter, set
  unitCost         Float    @default(0.0)
  totalCost        Float    @default(0.0) // quantityRequired * unitCost
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bom       Bom                 @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component ComponentInventory? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([bomId])
  @@index([componentSku])
  @@map("voop_bom_items")
}

model ComponentInventory {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  category       String   @default("COMPONENT") // RAW_MATERIAL, PACKAGING, COMPONENT, HARDWARE
  currentStock   Float    @default(0.0)
  reservedStock  Float    @default(0.0)
  availableStock Float    @default(0.0) // currentStock - reservedStock
  minStockLevel  Float    @default(10.0)
  reorderLevel   Float    @default(25.0)
  unit           String   @default("pcs") // pcs, ml, g, kg, box
  unitCost       Float    @default(0.0)
  supplier       String?
  location       String?  @default("Main Warehouse")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bomItems BomItem[]

  @@index([category])
  @@map("voop_component_inventory")
}

model ProductCostConfig {
  id                String   @id @default(cuid())
  shopifyVariantId  String   @unique
  cogsOverride      Float?
  packagingCost     Float    @default(15.0) // Default packaging cost
  shippingCostEst   Float    @default(80.0) // Default shipping cost
  gatewayFeePercent Float    @default(2.0) // 2% gateway fee
  otherCost         Float    @default(0.0)
  updatedAt         DateTime @updatedAt

  @@map("voop_product_cost_configs")
}

// -------------------------------------------------------------
// 3. META ADS MARKETING LAYER
// -------------------------------------------------------------

model MetaAccount {
  id           String    @id @default(cuid())
  adAccountId  String    @unique // e.g. "act_123456789"
  name         String
  currency     String    @default("INR")
  status       String    @default("ACTIVE")
  accessToken  String? // Stored strictly server-side
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaigns    MetaCampaign[]
  dailyMetrics MetaDailyMetric[]

  @@map("meta_accounts")
}

model MetaCampaign {
  id             String   @id @default(cuid())
  metaAccountId  String
  campaignId     String   @unique
  name           String
  status         String   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  objective      String?
  dailyBudget    Float?
  lifetimeBudget Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      MetaAccount       @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  adSets       MetaAdSet[]
  dailyMetrics MetaDailyMetric[]

  @@index([metaAccountId])
  @@map("meta_campaigns")
}

model MetaAdSet {
  id          String   @id @default(cuid())
  campaignId  String
  adSetId     String   @unique
  name        String
  status      String   @default("ACTIVE")
  dailyBudget Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign     MetaCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads          MetaAd[]
  dailyMetrics MetaDailyMetric[]

  @@index([campaignId])
  @@map("meta_ad_sets")
}

model MetaAd {
  id            String   @id @default(cuid())
  adSetId       String
  adId          String   @unique
  name          String
  status        String   @default("ACTIVE")
  creativeTitle String?
  creativeUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adSet        MetaAdSet         @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  dailyMetrics MetaDailyMetric[]

  @@index([adSetId])
  @@map("meta_ads")
}

model MetaDailyMetric {
  id            String   @id @default(cuid())
  metaAccountId String
  campaignId    String?
  adSetId       String?
  adId          String?
  date          String // YYYY-MM-DD
  spend         Float    @default(0.0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  purchases     Int      @default(0)
  revenue       Float    @default(0.0)
  cpc           Float    @default(0.0)
  cpm           Float    @default(0.0)
  ctr           Float    @default(0.0)
  cpp           Float    @default(0.0)
  roas          Float    @default(0.0)
  createdAt     DateTime @default(now())

  account  MetaAccount   @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  campaign MetaCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet    MetaAdSet?    @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad       MetaAd?       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([date, campaignId, adSetId, adId])
  @@index([date])
  @@map("meta_daily_metrics")
}

// -------------------------------------------------------------
// 4. DELHIVERY & INTEGRATION LAYER
// -------------------------------------------------------------

model DelhiveryConfig {
  id           String   @id @default(cuid())
  apiToken     String?
  clientName   String?  @default("MonkeyGarage")
  warehousePin String?  @default("560001")
  mode         String   @default("PRODUCTION") // PRODUCTION, STAGING
  isActive     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("delhivery_configs")
}

// -------------------------------------------------------------
// 5. SYSTEM AUDIT & VOOP API KEYS
// -------------------------------------------------------------

model SyncLog {
  id           String    @id @default(cuid())
  storeId      String?
  type         String // PRODUCTS, ORDERS, FULL_SYNC, BOM, META_ADS, WEBHOOK
  status       String // SUCCESS, FAILED, IN_PROGRESS
  recordsCount Int       @default(0)
  durationMs   Int       @default(0)
  errorDetails String?
  details      String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  store ShopifyStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([startedAt])
  @@map("sync_logs")
}

model ShopifyWebhookEvent {
  id             String    @id @default(cuid())
  storeId        String?
  topic          String // orders/create, orders/updated, products/update, etc.
  shopifyEventId String?
  payload        String
  status         String    @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  errorMessage   String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  store ShopifyStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([topic, receivedAt])
  @@map("shopify_webhook_events")
}

model VoopApiKey {
  id         String    @id @default(cuid())
  name       String    @default("Default VOOP Key")
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("voop_api_keys")
}
