generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 0. AUTHENTICATION & MULTI-TENANCY
// -------------------------------------------------------------

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  username               String?  @unique
  usernameLastChangedAt  DateTime? // Tracks the last username change — enforces 14-day cooldown
  passwordHash           String
  name                   String
  contactNo              String?
  businessName           String?
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  country                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  storeId      String?
  voopStoreId  String?  // Permanent, globally unique VOOP Store ID shared by users of this store
  tenantId     String?  // Permanent, globally unique Tenant ID shared by users of this store
  createdById  String?  // Admin User ID who invited/created this staff member
  role         String   @default("ADMIN") // ADMIN, STAFF
  permissions  String?  // JSON string e.g. '["DASHBOARD", "ORDERS"]'
  store        ShopifyStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  preference   UserPreference?
  memberships  StoreMembership[]

  @@index([storeId])
  @@index([voopStoreId])
  @@index([tenantId])
  @@map("users")
}

model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  themeMode   String   @default("dark")
  accentTheme String   @default("voop") // "voop", "emerald", "purple", "amber", "teal"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model StoreMembership {
  id          String       @id @default(cuid())
  userId      String
  storeId     String
  tenantId    String?      // Explicit tenant binding for cross-tenant validation
  status      String       @default("ACTIVE") // ACTIVE, DISABLED, REVOKED
  role        String       @default("STAFF") // ADMIN, STAFF
  permissions String?      // JSON string array e.g. '["orders.view", "shipments.view"]'
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([tenantId])
  @@index([status])
  @@map("store_memberships")
}

// -------------------------------------------------------------
// 1. SHOPIFY DATA INGESTION LAYER
// -------------------------------------------------------------

model ShopifyStore {
  id                 String               @id @default(cuid())
  voopStoreId        String?              @unique // Permanent, globally unique VOOP Store ID (e.g. VOOP-7F4K9X2M)
  tenantId           String?              @unique // Permanent, globally unique Tenant ID (e.g. TENANT-XXXXXX)
  publicStoreRef     String?              @unique // Cryptographically random, opaque public URL identifier (e.g. 7xK9mQ2Lp8Vn4R3)
  accountId          String?              // Associated primary VOOP account (User ID)
  shopDomain         String               @unique
  accessToken        String
  apiKey             String?
  apiSecret          String?
  webhookSecret      String?
  storeName          String?
  email              String?
  currency           String?              @default("INR")
  isConnected        Boolean              @default(true)
  lastProductSyncAt  DateTime?
  lastOrderSyncAt    DateTime?
  lastFullSyncAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  users              User[]
  memberships        StoreMembership[]
  products           ShopifyProduct[]
  variants           ShopifyVariant[]
  orders             ShopifyOrder[]
  stockItems         StockItem[]
  comboComponents    ComboComponent[]
  purchaseBills      PurchaseBill[]
  purchaseBillItems  PurchaseBillItem[]
  inventoryLedgers   InventoryLedger[]
  shipments          Shipment[]
  shipmentScans      ShipmentScan[]
  metaAccounts       MetaAccount[]
  metaCampaigns      MetaCampaign[]
  metaAdSets         MetaAdSet[]
  metaAds            MetaAd[]
  metaDailyMetrics   MetaDailyMetric[]
  metaPixels         MetaPixel[]
  metaPixelEvents    MetaPixelEvent[]
  delhiveryConfig    DelhiveryConfig?
  courierIntegrations CourierIntegration[]
  syncLogs           SyncLog[]
  syncJobs           SyncJob[]
  webhookEvents      ShopifyWebhookEvent[]
  apiKeys            VoopApiKey[]
  collaborations     Collaboration[]
  collabSetting      CollabSetting?
  expenseSetting     ExpenseSetting?
  productTaxConfigs  ProductTaxConfig[]
  comboInvoiceComponents ComboInvoiceComponent[]
  adPlatformAccounts AdPlatformAccount[]
  adDailyMetrics     AdDailyMetric[]
  offlineOrders      OfflineOrder[]
  offlineOrderItems  OfflineOrderItem[]

  orderItems         ShopifyOrderItem[]
  fulfillments       ShopifyFulfillment[]
  subscription       AppSubscription?
  storeSetting       StoreSetting?
  businessExpenses   BusinessExpense[]
  damageRecords      DamageRecord[]

  @@map("shopify_stores")
}

// -------------------------------------------------------------
// SYNC JOB — Live background sync state (separate from SyncLog history)
// -------------------------------------------------------------
model SyncJob {
  id             String    @id @default(cuid())
  storeId        String
  type           String    // "products" | "orders" | "all" | "single_order"
  status         String    @default("QUEUED") // QUEUED | IN_PROGRESS | COMPLETED | FAILED
  currentBatch   Int       @default(0)
  totalBatches   Int?
  processedCount Int       @default(0)
  totalCount     Int?
  pageInfo       String?   // Shopify cursor — stored after each batch for crash-resume
  errorMessage   String?
  metadata       Json?     // e.g. { orderId: "..." } for single-order sync
  startedAt      DateTime?
  completedAt    DateTime?
  heartbeat      DateTime? // Updated every batch — detects stale workers
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store          ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("sync_jobs")
}

model ShopifyProduct {
  id               String           @id @default(cuid())
  storeId          String
  shopifyProductId String
  title            String
  handle           String?
  productType      String?
  vendor           String?
  status           String           @default("ACTIVE")
  tags             String?
  imageUrl         String?
  rawPayload       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  syncedAt         DateTime         @default(now())

  store            ShopifyStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants         ShopifyVariant[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId, status])
  @@map("shopify_products")
}

model ShopifyVariant {
  id                  String         @id @default(cuid())
  storeId             String
  productId           String
  shopifyProductId    String
  shopifyVariantId    String         @unique
  title               String
  sku                 String?        @default("")
  barcode             String?
  price               Float          @default(0.0)
  compareAtPrice      Float?
  inventoryItemId     String?
  inventoryQuantity   Int?           @default(0)
  imageUrl            String?
  rawPayload          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  syncedAt            DateTime       @default(now())

  store               ShopifyStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product             ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyVariantId])
  @@index([storeId, sku])
  @@index([shopifyVariantId])
  @@map("shopify_variants")
}

model ShopifyOrder {
  id                 String               @id @default(cuid())
  storeId            String
  shopifyOrderId     String
  shopifyOrderNumber String?              // Canonical sequential integer from Shopify (e.g. "1925")
  shopifyOrderName   String?              // Canonical merchant-facing order string (e.g. "#2026-1925" or "#1925")
  shopifyOrderCreatedAt DateTime?         // Canonical Shopify order.created_at timestamp
  orderNumber        String               // Stored order number / name for backward compatibility
  name               String               // Stored order name for backward compatibility
  customerName       String?              // Authoritative customer name (separated from order name)
  email              String?
  phone              String?
  currency           String               @default("INR")
  totalPrice         Float                @default(0.0)
  subtotalPrice      Float                @default(0.0)
  totalDiscounts     Float                @default(0.0)
  totalTax           Float                @default(0.0)
  financialStatus    String               @default("PAID")
  fulfillmentStatus  String               @default("UNFULFILLED")
  deliveryStatus     String?              @default("UNFULFILLED")
  outwardScanned     Boolean              @default(false)
  outwardScannedAt   DateTime?
  rtoInwardScanned   Boolean              @default(false)
  rtoInwardScannedAt DateTime?
  pickupDate         DateTime?
  etdDate            DateTime?
  processedAt        DateTime?
  cancelledAt        DateTime?
  deletedAt          DateTime?
  tags               String?
  note               String?
  shippingAddress        String?
  rawPayload             String?
  invoiceCompanySnapshot String?              // Immutable JSON snapshot of company master at invoice generation
  createdAt              DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  syncedAt           DateTime             @default(now())

  store              ShopifyStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items              ShopifyOrderItem[]
  fulfillments       ShopifyFulfillment[]

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, orderNumber])
  @@index([storeId, shopifyOrderNumber])
  @@index([storeId, shopifyOrderName])
  @@index([storeId, financialStatus])
  @@index([storeId, fulfillmentStatus])
  @@index([storeId, deliveryStatus])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("shopify_orders")
}

model ShopifyOrderItem {
  id                 String         @id @default(cuid())
  storeId            String
  orderId            String
  shopifyOrderId     String
  shopifyLineItemId  String
  shopifyProductId   String?
  shopifyVariantId   String?
  productTitle       String
  variantTitle       String?
  sku                String?        @default("")
  quantity           Int            @default(1)
  fulfilledQuantity  Int            @default(0)
  deductedQuantity   Int            @default(0)
  reversedQuantity   Int            @default(0)
  unitPrice          Float          @default(0.0)
  discountTotal      Float          @default(0.0)
  totalPrice         Float          @default(0.0)
  isDeducted         Boolean        @default(false)
  deductionStatus    String         @default("PENDING") // DEDUCTED, MAPPING_REQUIRED, IGNORED
  deductedComponents String?        // JSON of deducted SKUs and counts
  comboInvoiceComponents String?    // JSON snapshot of custom invoice component breakdown at order time
  rawPayload         String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  store              ShopifyStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              ShopifyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyLineItemId])
  @@index([storeId, shopifyVariantId])
  @@index([sku])
  @@index([deletedAt])
  @@map("shopify_order_items")
}

model ShopifyFulfillment {
  id                   String       @id @default(cuid())
  storeId              String
  orderId              String
  shopifyOrderId       String
  shopifyFulfillmentId String
  status               String       @default("SUCCESS")
  trackingCompany      String?
  trackingNumber       String?
  trackingUrl          String?
  deliveryStatus       String?      @default("MANIFESTED")
  pickupDate           DateTime?
  etdDate              DateTime?
  deliveryDate         DateTime?
  rtoDeliveredDate     DateTime?
  lineItemIds          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  store                ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order                ShopifyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyFulfillmentId])
  @@index([trackingNumber])
  @@map("shopify_fulfillments")
}

// -------------------------------------------------------------
// 2. VOOP SKU-BASED PHYSICAL INVENTORY & BILLING
// -------------------------------------------------------------

model StockItem {
  id             String            @id @default(cuid())
  storeId        String
  sku            String            // Unique VOOP SKU per store (e.g. FOAM, SNOW)
  name           String            // Descriptive Name
  type           String            @default("SINGLE") // SINGLE, COMBO
  category       String            @default("FINISHED_GOODS") // FINISHED_GOODS, RAW_MATERIAL, PACKAGING, COMPONENT
  unit           String            @default("pcs") // pcs, box, ml, kg, roll
  currentStock   Float             @default(0.0)   // Total saleable physical stock on hand (0 for COMBO)
  damagedStock   Float             @default(0.0)   // Total damaged physical stock on hand (0 for COMBO)
  reservedStock  Float             @default(0.0)
  availableStock Float             @default(0.0)   // currentStock - reservedStock
  minStockLevel  Float             @default(10.0)
  reorderLevel   Float             @default(25.0)
  avgUnitCost    Float             @default(0.0)   // Weighted average unit purchase cost
  sellingPrice   Float?            @default(0.0)   // Retail selling price
  costPrice      Float?            @default(0.0)   // Base cost price without profit
  location       String?           @default("Main Warehouse")
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  store             ShopifyStore      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ledgerEntries     InventoryLedger[]
  comboComponents   ComboComponent[]  @relation("ComboToComponents")
  componentInCombos ComboComponent[]  @relation("ComponentToCombos")

  @@unique([storeId, sku])
  @@index([storeId, sku])
  @@index([storeId, type])
  @@index([storeId, category])
  @@map("voop_stock_items")
}

model ComboComponent {
  id           String    @id @default(cuid())
  storeId      String
  comboSku     String
  componentSku String
  quantity     Float     @default(1.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store         ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  comboItem     StockItem    @relation("ComboToComponents", fields: [storeId, comboSku], references: [storeId, sku], onDelete: Cascade)
  componentItem StockItem    @relation("ComponentToCombos", fields: [storeId, componentSku], references: [storeId, sku], onDelete: Cascade)

  @@unique([storeId, comboSku, componentSku])
  @@index([storeId, comboSku])
  @@index([storeId, componentSku])
  @@map("voop_combo_components")
}

model PurchaseBill {
  id             String             @id @default(cuid())
  storeId        String
  billNumber     String             // e.g. "INV-2026-001"
  billType       String             @default("INVENTORY") // INVENTORY, SHIPPING_LOGISTICS, PACKAGING, MARKETING_ADS, OPERATIONAL_OVERHEAD, MISC
  supplier       String             // Vendor / Supplier Name
  billDate       DateTime           @default(now())
  dueDate        DateTime?
  paymentStatus  String             @default("PAID") // PAID, PENDING, PARTIAL, OVERDUE
  paymentMode    String?            @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, CASH
  subtotal       Float              @default(0.0)
  taxTotal       Float              @default(0.0)
  discountTotal  Float              @default(0.0)
  totalAmount    Float              @default(0.0)
  notes          String?
  attachmentUrl  String?
  status         String             @default("POSTED") // POSTED, DRAFT, CANCELLED
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  store          ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          PurchaseBillItem[]
  ledgerEntries  InventoryLedger[]

  @@unique([storeId, billNumber])
  @@index([storeId, billType])
  @@index([storeId, paymentStatus])
  @@index([storeId, billDate])
  @@map("voop_purchase_bills")
}

model PurchaseBillItem {
  id                String       @id @default(cuid())
  storeId           String
  billId            String
  sku               String?      // Optional for operational expenses, required for inventory GRN
  itemName          String       // Name of item/service
  category          String?      @default("INVENTORY")
  quantity          Float        @default(1.0)
  unitCost          Float        @default(0.0)
  taxRate           Float        @default(0.0) // Percentage (e.g. 18.0 for 18% GST)
  taxAmount         Float        @default(0.0)
  discount          Float        @default(0.0)
  totalAmount       Float        @default(0.0) // (quantity * unitCost - discount) + taxAmount
  alreadyAddedToPnl Boolean      @default(false) // If true, exclude this line from P&L calculations (prevents double-counting)
  createdAt         DateTime     @default(now())

  store        ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bill         PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([storeId, billId])
  @@index([storeId, sku])
  @@map("voop_purchase_bill_items")
}

model InventoryLedger {
  id              String        @id @default(cuid())
  storeId         String
  sku             String        // The VOOP Stock Item SKU
  type            String        // SALE_FULFILLMENT, RTO_RETURN, RTO_DAMAGE, DAMAGE_ADJUSTMENT, MANUAL_ADJUSTMENT, PURCHASE_RECEIPT, GRN, DAMAGE_TO_SALEABLE
  inventoryBucket String        @default("SALEABLE") // SALEABLE, DAMAGED
  quantity        Float         // Positive for in (+100), Negative for out (-2)
  unitCost        Float         @default(0.0)
  balanceAfter    Float         @default(0.0) // Physical stock balance after transaction
  referenceType   String?       // PURCHASE_BILL, SHOPIFY_ORDER, SHIPMENT_RTO, MANUAL_ADJUSTMENT
  referenceId     String?       // Bill ID, Order ID, or AWB
  orderId         String?
  orderLineId     String?
  fulfillmentId   String?
  shipmentId      String?
  billId          String?
  productId       String?
  variantId       String?
  idempotencyKey        String?
  originalLedgerEntryId String?
  fulfillmentLineId     String?
  reversalReference     String?
  createdBy             String?       @default("System")
  notes                 String?
  createdAt             DateTime      @default(now())

  store           ShopifyStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockItem       StockItem?    @relation(fields: [storeId, sku], references: [storeId, sku], onDelete: Cascade)
  bill            PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([storeId, sku, createdAt])
  @@index([storeId, type])
  @@index([storeId, inventoryBucket])
  @@index([storeId, referenceId])
  @@index([storeId, shipmentId])
  @@index([storeId, idempotencyKey])
  @@index([storeId, originalLedgerEntryId])
  @@map("voop_inventory_ledger")
}

// -------------------------------------------------------------
// 3. META ADS MARKETING LAYER
// -------------------------------------------------------------

model MetaAccount {
  id                  String             @id @default(cuid())
  storeId             String
  adAccountId         String
  name                String
  currency            String             @default("INR")
  status              String             @default("ACTIVE")
  accessToken         String?
  lastSyncedAt        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store               ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns           MetaCampaign[]
  dailyMetrics        MetaDailyMetric[]

  @@unique([storeId, adAccountId])
  @@index([storeId])
  @@map("meta_accounts")
}

model MetaCampaign {
  id                  String             @id @default(cuid())
  storeId             String
  metaAccountId       String
  campaignId          String
  name                String
  status              String             @default("ACTIVE")
  objective           String?
  dailyBudget         Float?
  lifetimeBudget      Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store               ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  account             MetaAccount        @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  adSets              MetaAdSet[]
  dailyMetrics        MetaDailyMetric[]

  @@unique([storeId, campaignId])
  @@index([storeId, metaAccountId])
  @@map("meta_campaigns")
}

model MetaAdSet {
  id                  String             @id @default(cuid())
  storeId             String
  campaignId          String
  adSetId             String
  name                String
  status              String             @default("ACTIVE")
  dailyBudget         Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store               ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign            MetaCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads                 MetaAd[]
  dailyMetrics        MetaDailyMetric[]

  @@unique([storeId, adSetId])
  @@index([storeId, campaignId])
  @@map("meta_ad_sets")
}

model MetaAd {
  id                  String             @id @default(cuid())
  storeId             String
  adSetId             String
  adId                String
  name                String
  status              String             @default("ACTIVE")
  creativeTitle       String?
  creativeUrl         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store               ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adSet               MetaAdSet          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  dailyMetrics        MetaDailyMetric[]

  @@unique([storeId, adId])
  @@index([storeId, adSetId])
  @@map("meta_ads")
}

model MetaDailyMetric {
  id                  String             @id @default(cuid())
  storeId             String
  metaAccountId       String
  campaignId          String?
  adSetId             String?
  adId                String?
  date                String
  spend               Float              @default(0.0)
  impressions         Int                @default(0)
  clicks              Int                @default(0)
  purchases           Int                @default(0)
  revenue             Float              @default(0.0)
  cpc                 Float              @default(0.0)
  cpm                 Float              @default(0.0)
  ctr                 Float              @default(0.0)
  cpp                 Float              @default(0.0)
  roas                Float              @default(0.0)
  createdAt           DateTime           @default(now())

  store               ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  account             MetaAccount        @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  campaign            MetaCampaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSet               MetaAdSet?         @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  ad                  MetaAd?            @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, campaignId, adSetId, adId])
  @@index([storeId, date])
  @@map("meta_daily_metrics")
}

model MetaPixel {
  id             String           @id @default(cuid())
  storeId        String
  pixelId        String
  name           String?          @default("Facebook Pixel")
  accessToken    String
  testEventCode  String?
  status         String           @default("ACTIVE")
  lastFiredAt    DateTime?
  lastSyncedAt   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store          ShopifyStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  events         MetaPixelEvent[]

  @@unique([storeId, pixelId])
  @@index([storeId])
  @@map("meta_pixels")
}

model MetaPixelEvent {
  id         String    @id @default(cuid())
  storeId    String
  pixelId    String
  eventName  String    // PageView, ViewContent, AddToCart, InitiateCheckout, Purchase
  eventCount Int       @default(0)
  date       String    // YYYY-MM-DD
  timestamp  DateTime  @default(now())

  store      ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pixel      MetaPixel    @relation(fields: [storeId, pixelId], references: [storeId, pixelId], onDelete: Cascade)

  @@unique([storeId, pixelId, eventName, date])
  @@map("meta_pixel_events")
}

// -------------------------------------------------------------
// 4. DELHIVERY & INTEGRATION LAYER
// -------------------------------------------------------------

model DelhiveryConfig {
  id                  String       @id @default(cuid())
  storeId             String       @unique
  apiToken            String?
  clientName          String?      @default("MonkeyGarage")
  warehousePin        String?      @default("560001")
  mode                String       @default("PRODUCTION")
  isActive            Boolean      @default(false)
  updatedAt           DateTime     @updatedAt

  store               ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("delhivery_configs")
}

model CourierIntegration {
  id                   String    @id @default(cuid())
  storeId              String
  voopStoreId          String?
  courier              String    // DELHIVERY, BLUEDART, XPRESSBEES, ECOM_EXPRESS, EKART, SHADOWFAX
  status               String    @default("NOT_CONNECTED") // CONNECTED, NOT_CONNECTED, ERROR
  credentialsEncrypted String?   // Encrypted JSON of credentials
  environment          String    @default("PRODUCTION") // PRODUCTION, STAGING
  lastTestedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store                ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, courier])
  @@index([storeId, courier])
  @@index([voopStoreId, courier])
  @@map("courier_integrations")
}

// -------------------------------------------------------------
// 5. SYSTEM AUDIT & VOOP API KEYS
// -------------------------------------------------------------

model SyncLog {
  id           String        @id @default(cuid())
  storeId      String
  type         String
  status       String
  recordsCount Int           @default(0)
  durationMs   Int           @default(0)
  errorDetails String?
  details      String?
  startedAt    DateTime      @default(now())
  completedAt  DateTime?

  store        ShopifyStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type, status])
  @@index([storeId, startedAt])
  @@map("sync_logs")
}

model ShopifyWebhookEvent {
  id             String        @id @default(cuid())
  storeId        String?
  topic          String
  shopifyEventId String?
  payload        String
  status         String        @default("PROCESSED")
  errorMessage   String?
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  store          ShopifyStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([topic, receivedAt])
  @@map("shopify_webhook_events")
}

model VoopApiKey {
  id          String    @id @default(cuid())
  storeId     String
  name        String    @default("Default VOOP Key")
  keyHash     String
  keyPrefix   String
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, keyHash])
  @@map("voop_api_keys")
}

// -------------------------------------------------------------
// 6. LOGISTICS SHIPMENTS & OUTWARD SCANNER LAYER
// -------------------------------------------------------------

model Shipment {
  id                      String         @id @default(cuid())
  storeId                 String
  awb                     String         // Delhivery AWB / Tracking number
  shopifyOrderId          String?
  shopifyOrderNumber      String?        // Canonical Shopify order number (e.g. "1925")
  shopifyOrderName        String?        // Canonical formatted order name (e.g. "#2026-1925" or "#1925")
  orderNumber             String?        // Formatted order number / name for backward compatibility
  carrier                 String?        @default("Delhivery")
  status                  String?        @default("Manifested") // display / raw status
  normalizedStatus        String?        @default("MANIFESTED") // MANIFESTED, DISPATCHED, IN-TRANSIT, OUT-FOR-DELIVERY, DELIVERED, RTO, CANCELLED
  rawStatus               String?        // Exact status string from Delhivery API
  statusType              String?        // Status Type e.g. "RT", "DL", "UD", "IT", "PP"
  statusLocation          String?        // Latest location e.g. "Mumbai_Dwarligaon_D"
  statusTimestamp         DateTime?      // Timestamp of latest scan
  statusInstructions      String?        // Instructions / remarks from latest scan
  payment                 String?        @default("Prepaid") // COD, Prepaid
  amount                  Float?         @default(0.0)
  date                    String?        // Date string e.g. "2026-08-30"
  orderCreatedAt          DateTime?      // Canonical Shopify order.created_at — primary business date for sorting & filtering
  shippingCharge          Float?         @default(0.0)
  scannedAtHome           Boolean        @default(false)
  outwardScanned          Boolean        @default(false)
  outwardScannedAt        DateTime?
  rtoInwardScanned        Boolean        @default(false)
  rtoInwardScannedAt      DateTime?
  rtoInventoryProcessed   Boolean        @default(false)
  rtoReceivedAt           DateTime?
  rtoCondition            String?        // all_good, some_damaged, all_damaged
  rtoReceivedBy           String?
  rtoInspectionDetails    String?        // JSON of returned components, quantities & conditions
  pickupDate              DateTime?
  etdDate                 DateTime?
  deliveryDate            DateTime?
  rtoDate                 DateTime?
  ndrStatus               String?
  rtoDiscrepancy          Boolean        @default(false)
  inwardScannedAt         DateTime?
  inTransitDate           DateTime?
  deletedAt               DateTime?
  amountFetched           Boolean        @default(false)
  isReplacementOutward    Boolean        @default(false)
  isReversePickupReceived Boolean        @default(false)
  isReplacementRto        Boolean        @default(false)
  replacementOutwardAt    DateTime?
  reversePickupAt         DateTime?
  replacementRtoAt        DateTime?
  customerName            String?
  customerPhone           String?
  notes                   String?
  shopifyFulfillmentId    String?        // Associated Shopify fulfillment ID
  trackingCompany         String?        // Original courier company name reported by Shopify
  trackingUrl             String?        // Official tracking URL if provided by Shopify
  courierType             String?        // DELHIVERY, BLUEDART, XPRESSBEES, ECOM_EXPRESS, EKART, SHADOWFAX, UNKNOWN
  lineItemsSummary        String?        // JSON summary of fulfilled products & quantities
  lastSyncedAt            DateTime?      // When courier tracking was last fetched
  rawTrackingPayload      String?        // Full raw JSON from courier API
  rtoVerificationStatus   String?        // VERIFIED, UNVERIFIED
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  store                   ShopifyStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scans                   ShipmentScan[]
  damageRecords           DamageRecord[]

  @@unique([storeId, awb])
  @@index([storeId, status])
  @@index([storeId, normalizedStatus])
  @@index([storeId, outwardScanned])
  @@index([storeId, orderNumber])
  @@index([storeId, shopifyOrderNumber])
  @@index([storeId, shopifyOrderName])
  @@index([storeId, date])
  @@index([storeId, orderCreatedAt])
  @@index([storeId, shopifyFulfillmentId])
  @@map("shipments")
}

model ShipmentScan {
  id              String    @id @default(cuid())
  storeId         String
  shipmentId      String
  awb             String
  status          String
  statusType      String?
  location        String?
  instructions    String?
  nslCode         String?
  timestamp       DateTime
  rawPayload      String?
  createdAt       DateTime  @default(now())

  store           ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([storeId, awb, timestamp, status, location])
  @@index([storeId, awb])
  @@index([storeId, timestamp])
  @@map("shipment_scans")
}

// -------------------------------------------------------------
// 7. CREATOR COLLABORATIONS & CUSTOM FORM BUILDER LAYER
// -------------------------------------------------------------

model Collaboration {
  id              Int       @id @default(autoincrement())
  storeId         String
  instagramLink   String?
  instagramId     String?
  daysToCreate    String?
  contentType     String?
  platforms       String?
  vehicleOwned    String?
  vehicleUsed     String?
  fullName        String?
  place           String?
  whatsappNumber  String?
  address         String?
  collabType      String?   @default("Barter") // Barter, Paid, Gifting
  status          String?   @default("New Request") // New Request, Approved, Dispatched, Content Received, Rejected
  awb             String?
  couponCode      String?
  customResponses String?   // JSON of custom form fields
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store           ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, instagramId])
  @@map("collaborations")
}

model CollabSetting {
  id                 String   @id @default(cuid())
  storeId            String   @unique
  bannerUrl          String?
  bannerImageBase64  String?
  title              String   @default("BARTER COLLAB x VOOP")
  description        String   @default("Please fill out the details below to apply for a creator collaboration.")
  themeColor         String   @default("#06b6d4")
  privacyUrl         String?
  termsUrl           String?
  formSchema         String   @default("[]") // JSON string of form fields
  customStyles       String?  @default("{}") // JSON string of styling config
  updatedAt          DateTime @updatedAt

  store              ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("collab_settings")
}



// -------------------------------------------------------------
// 9. DYNAMIC P&L EXPENSE RULES & CUSTOMIZATION LAYER
// -------------------------------------------------------------

model ExpenseSetting {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  packagingCostPerOrder Float    @default(30.0) // Default ₹30 / package
  freightCostPerOrder   Float    @default(90.0) // Default ₹90 / dispatched order
  rtoCostPerOrder       Float    @default(90.0) // Default ₹90 / RTO reverse courier penalty
  gatewayFeePercent     Float    @default(2.0)  // Default 2%
  monthlyFixedOverhead  Float    @default(0.0)  // Monthly office/warehouse rent & salaries
  defaultCogsPercent    Float    @default(0.0)  // Fallback COGS %
  autoFetchMetaAds      Boolean  @default(true) // Auto-fetch live Meta ad spend
  useEstimatedExpenses  Boolean  @default(true) // Use per-order rate if bills not entered
  customRules           String?  @default("{}") // Additional custom expense rules (JSON)
  updatedAt             DateTime @updatedAt

  store                 ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("expense_settings")
}

// -------------------------------------------------------------
// 10. SALES TAX & SKU GST CONFIGURATION
// -------------------------------------------------------------

model ProductTaxConfig {
  id                 String   @id @default(cuid())
  storeId            String
  shopifyProductId   String?
  shopifyVariantId   String?
  sku                String
  title              String?
  hsnCode            String?  @default("")
  taxRate            Float    @default(18.0) // GST Tax Rate % (e.g., 0, 5, 12, 18, 28)
  isTaxInclusive     Boolean  @default(true) // Whether product selling price is inclusive of tax
  overridePrice      Float?   // Custom override selling price
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store              ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sku])
  @@index([storeId, sku])
  @@index([storeId, shopifyVariantId])
  @@map("voop_product_tax_configs")
}

// -------------------------------------------------------------
// 10B. COMBO CUSTOM INVOICE COMPONENT BREAKDOWN
// -------------------------------------------------------------

model ComboInvoiceComponent {
  id             String       @id @default(cuid())
  storeId        String
  comboSku       String       // Parent Combo SKU
  componentSku   String       // Child Component SKU
  quantity       Float        @default(1.0)
  allocatedValue Float        @default(0.0) // Merchant allocated invoice price
  gstRate        Float        @default(18.0) // Custom GST rate % for this component in this combo
  hsnCode        String?      @default("")
  taxMode        String       @default("INCLUSIVE") // INCLUSIVE | EXCLUSIVE
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  store          ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, comboSku, componentSku])
  @@index([storeId, comboSku])
  @@index([storeId, componentSku])
  @@map("voop_combo_invoice_components")
}

// -------------------------------------------------------------
// 11. OMNICHANNEL AD PLATFORMS (META, GOOGLE, SNAPCHAT, REDDIT)
// -------------------------------------------------------------

model AdPlatformAccount {
  id              String          @id @default(cuid())
  storeId         String
  platform        String          // "META", "GOOGLE", "SNAPCHAT", "REDDIT"
  accountId       String          // e.g. "act_123456", "123-456-7890", "snap_xxx", "t2_xxx"
  accountName     String          // Descriptive name / Brand label
  currency        String          @default("INR")
  status          String          @default("ACTIVE") // "ACTIVE", "PAUSED", "DISCONNECTED", "ERROR"
  accessToken     String?         // OAuth Access Token / API Token / Refresh Token
  refreshToken    String?         // OAuth Refresh Token
  clientId        String?         // Client ID / App ID
  clientSecret    String?         // Client Secret / App Secret
  developerToken  String?         // For Google Ads Developer Token
  organizationId  String?         // For Snapchat Ads Org ID
  pixelId         String?         // Optional linked tracking pixel ID
  extraConfig     String?         @default("{}") // Additional platform JSON config
  spendThisMonth  Float           @default(0.0)
  roas            Float           @default(0.0)
  lastSyncedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  store           ShopifyStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dailyMetrics    AdDailyMetric[]

  @@unique([storeId, platform, accountId])
  @@index([storeId, platform])
  @@index([storeId, status])
  @@map("ad_platform_accounts")
}

model AdDailyMetric {
  id              String             @id @default(cuid())
  storeId         String
  accountId       String
  date            String             // "YYYY-MM-DD"
  platform        String             // "META", "GOOGLE", "SNAPCHAT", "REDDIT"
  spend           Float              @default(0.0)
  impressions     Int                @default(0)
  clicks          Int                @default(0)
  conversions     Int                @default(0)
  revenue         Float              @default(0.0)
  cpc             Float              @default(0.0)
  cpm             Float              @default(0.0)
  ctr             Float              @default(0.0)
  roas            Float              @default(0.0)
  createdAt       DateTime           @default(now())

  store           ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  account         AdPlatformAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([storeId, accountId, date])
  @@index([storeId, platform, date])
  @@map("ad_daily_metrics")
}

// -------------------------------------------------------------
// 12. COMPANY PROFILE & INVOICE SETTINGS (SINGLETON)
// -------------------------------------------------------------

model StoreSetting {
  storeId             String   @id // Linked 1-to-1 with ShopifyStore
  companyName         String   @default("")
  tradeName           String?  @default("")
  gstin               String?  @default("") // 15-digit GSTIN
  pan                 String?  @default("") // 10-digit PAN
  cin                 String?  // Corporate Identification Number
  lutNumber           String?  // LUT / Export Bond Number (if applicable)

  // Addresses
  addressLine1        String   @default("")
  addressLine2        String?  @default("")
  city                String   @default("")
  state               String   @default("")
  stateCode           String   @default("")
  pincode             String   @default("")
  country             String   @default("India")

  // Contact
  email               String?  @default("")
  phone               String?  @default("")
  website             String?  @default("")
  logoUrl             String?  // URL of company logo for invoice header

  // Bank Details for Invoices
  bankName            String?  @default("")
  accountNumber       String?  @default("")
  ifscCode            String?  @default("")
  accountHolderName   String?  @default("")
  branchName          String?  @default("")
  upiId               String?  @default("")

  // Invoice Configuration
  invoicePrefix       String   @default("INV-2026-")
  invoiceCounter      Int      @default(1001)
  termsConditions     String?  @default("1. Goods once sold will be replaced only if damaged in transit.\n2. This is a computer generated tax invoice.")
  authorizedSignatory String?  @default("Authorized Signatory")
  declaration         String?  @default("We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.")
  signatureUrl        String?  // Optional digital signature / stamp image

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  store               ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

// -------------------------------------------------------------
// 13. OFFLINE BILLING (Walk-In / WhatsApp / Phone Orders)
// -------------------------------------------------------------

model OfflineOrder {
  id              String             @id @default(cuid())
  storeId         String
  orderNumber     String             // e.g. BILL-2026-0001
  channel         String             @default("WALK_IN") // WALK_IN, WHATSAPP, PHONE, INSTAGRAM
  customerName    String?
  customerPhone   String?
  customerAddress String?            // JSON: { line1, city, state, pincode }

  // Payment
  paymentMode     String             @default("CASH") // CASH, UPI, CARD, BANK_TRANSFER, COD
  paymentStatus   String             @default("PAID") // PAID, PENDING, PARTIAL

  // Financials
  subtotal        Float              @default(0.0)
  totalDiscount   Float              @default(0.0)
  totalTax        Float              @default(0.0)
  shippingCharge  Float              @default(0.0)
  totalAmount     Float              @default(0.0)
  advanceAmount   Float              @default(0.0)
  pendingAmount   Float              @default(0.0)

  notes           String?

  // Courier / Shipment integration
  courier         String?            // Delhivery, DTDC, BlueDart, Ecom, XpressBees, Other
  trackingNumber  String?            // AWB — links to Shipment table when set
  delhiveryRefNo  String?            // ReferenceNo returned by Delhivery lookup

  // Order status
  status          String             @default("CONFIRMED") // CONFIRMED, CANCELLED
  cancelledAt            DateTime?
  deletedAt              DateTime?
  invoiceCompanySnapshot String?            // Immutable JSON snapshot of company master at invoice generation

  createdAt              DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  store           ShopifyStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items           OfflineOrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId, channel])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, trackingNumber])
  @@index([storeId, customerPhone])
  @@map("offline_orders")
}

model OfflineOrderItem {
  id           String       @id @default(cuid())
  storeId      String
  orderId      String
  sku          String       // VOOP StockItem SKU
  productName  String       // Denormalized for display / invoice
  quantity     Float        @default(1.0)
  unitPrice    Float        @default(0.0)  // Custom / override selling price
  discount     Float        @default(0.0)  // Per-line discount amount
  taxRate      Float        @default(0.0)  // GST % fetched from ProductTaxConfig
  taxAmount    Float        @default(0.0)
  totalAmount  Float        @default(0.0)
  hsnCode      String?
  comboInvoiceComponents String?    // JSON snapshot of custom invoice component breakdown at order time
  createdAt    DateTime     @default(now())

  store        ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        OfflineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, orderId])
  @@index([storeId, sku])
  @@map("offline_order_items")
}

// -------------------------------------------------------------
// SHOPIFY APP SUBSCRIPTION (Billing)
// -------------------------------------------------------------

model AppSubscription {
  id                    String   @id @default(cuid())
  storeId               String   @unique
  companyId             String?

  // Shopify charge details
  shopifyChargeId       String?  @unique
  shopifyConfirmationUrl String?
  status                String   @default("PENDING")
  // Statuses: PENDING | ACTIVE | DECLINED | EXPIRED | FROZEN | CANCELLED | TRIAL

  // Plan details
  planName              String   @default("VOOP Professional")
  planPrice             Float    @default(999.0)  // in INR / USD
  currency              String   @default("INR")
  trialDays             Int      @default(60)
  trialEndsAt           DateTime?
  billingOn             DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store                 ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@map("app_subscriptions")
}

// -------------------------------------------------------------
// BUSINESS EXPENSES (Analytics & Profitability)
// -------------------------------------------------------------

model BusinessExpense {
  id          String       @id @default(cuid())
  storeId     String
  amount      Float
  category    String       // Advertising, Shipping, Product Cost, Packaging, Payment Gateway, RTO, Returns, Salaries, Software / Apps, Other
  date        DateTime     @default(now())
  description String
  vendor      String?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store       ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([storeId, category])
  @@map("business_expenses")
}

// -------------------------------------------------------------
// 15. DAMAGE TRACKING
// -------------------------------------------------------------

model DamageRecord {
  id             String       @id @default(cuid())
  storeId        String
  shipmentId     String?
  orderId        String?
  awb            String
  idempotencyKey String?
  damagedItems   String       // JSON array of { sku, quantity, parentComboSku }
  receivedBy     String?
  notes          String?
  inventoryMoved Boolean      @default(true)
  createdAt      DateTime     @default(now())

  store          ShopifyStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment       Shipment?    @relation(fields: [storeId, awb], references: [storeId, awb], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, awb])
  @@map("damage_records")
}

